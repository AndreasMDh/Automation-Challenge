{
    "name": "99co_homepage_automation",
    "version": "1.0.0",
    "description": "Android UI automation testing for the 99.co homepage",
    "main": "wdio.conf.js",
    "scripts": {
        "test": "wdio run ./wdio.conf.js",
        "test:dry": "wdio run ./wdio.conf.js --dry-run",
        "appium:server": "appium --address 127.0.0.1 --port 4723",
        "appium:driver:install": "appium driver install uiautomator2"
    },

    "keywords": [
        "qa",
        "automation",
        "appium",
        "webdriverio",
        "cucumber",
        "android"
    ],

    "license": "ISC",
    "engines": {
        "node": ">=22.22.2"
    },
    
    "devDependencies": {
        "@wdio/cli": "^9.19.2",
        "@wdio/cucumber-framework": "^9.19.2",
        "@wdio/local-runner": "^9.19.2",
        "@wdio/spec-reporter": "^9.19.2",
        "appium": "^4.0.0",
        "appium-uiautomator2-driver": "^9.2.2"
    }
}
